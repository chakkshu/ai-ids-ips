!data/processed/.gitkeep

# ML Model Registry artifacts (generated files, never commit)
ml/models/*
!ml/models/.gitkeep
ml/registry/staging/
ml/registry/active/
ml/registry/archive/
ml/registry/active.json
!ml/registry/.gitkeep

