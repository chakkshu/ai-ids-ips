# AI-IDS/IPS Web API & Dashboard Containerfile
FROM python:3.11-slim as base

# Security & environment settings
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install security updates and build requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Create unprivileged system user for OWASP least-privilege compliance
RUN groupadd -r idsgroup && useradd -r -g idsgroup -s /sbin/nologin idsuser

# Copy application source code
COPY . .
RUN chown -R idsuser:idsgroup /app

USER idsuser

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/api/v1/health/live || exit 1

CMD ["python", "run.py", "web-api"]
