# ==============================================================================
# AI-IDS/IPS Enterprise Environment Configuration Template
# Copy this file to .env and configure secret keys and endpoints appropriately.
# NEVER commit the active .env file to source control.
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
APP_DEBUG=False
APP_SECRET_KEY=change-this-to-a-cryptographically-secure-random-string-min-32-chars

# Master Key Encryption Key (KEK) for AES-256-GCM Envelope Encryption (32 bytes / 64 hex chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_MASTER_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_KEK_VERSION=v1

# HMAC Secret for Tamper-Evident Hash-Chained Audit Ledger
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_ids_ips
DB_USER=ids_admin
DB_PASSWORD=ids_secure_password_replace_in_prod
DATABASE_URL=postgresql://ids_admin:ids_secure_password_replace_in_prod@localhost:5432/ai_ids_ips

# Redis Configuration (Queue, PubSub, Rate-Limiting, Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Redis Stream Contract (Phase 5)
STREAM_RAW_FLOWS=raw-flows
STREAM_DETECTIONS=detections:stream
STREAM_PREVENTION=prevention:action
STREAM_DEAD_LETTER=raw-flows:dead-letter
STREAM_DETECTIONS_DEAD_LETTER=detections:stream:dead-letter
STREAM_CONSUMER_GROUP=detection-engine
STREAM_CONSUMER_NAME=detection-worker-1
STREAM_BATCH_SIZE=32
STREAM_BLOCK_MS=1000
STREAM_MAXLEN=10000
STREAM_MAX_PENDING=512
STREAM_MAX_ATTEMPTS=3

# Network Packet Capture (Sensor) Settings
# CAPTURE_MODE is canonical when set; otherwise SENSOR_SIMULATION_MODE decides.
CAPTURE_MODE=simulation
SENSOR_INTERFACE=auto
SENSOR_BPF_FILTER=ip
SENSOR_FLOW_TIMEOUT_ACTIVE=120
SENSOR_FLOW_TIMEOUT_IDLE=30
SENSOR_SIMULATION_MODE=True

# Prevention Engine Policy
# PREVENTION_MODE: "dry_run" (logs & simulates blocks) or "active" (enforces in OS firewall)
PREVENTION_MODE=dry_run
PREVENTION_REQUIRE_APPROVAL=False
PREVENTION_CONFIDENCE_THRESHOLD=0.85
PREVENTION_MIN_DETECTIONS=2
PREVENTION_WINDOW_SECONDS=60
PREVENTION_BLOCK_DURATION_MINUTES=15
# Immutable CIDR Whitelist (comma-separated, never blocked)
PREVENTION_WHITELIST=127.0.0.1/32,::1/128,192.168.1.1/32,10.0.0.1/32

# Machine Learning & Model Registry
ML_MODEL_REGISTRY_PATH=ml/registry
ML_ACTIVE_MODEL_VERSION=1.0.0
ML_DRIFT_THRESHOLD_PSI=0.25
ML_DRIFT_CRITICAL_PSI=0.5
ML_DRIFT_P_VALUE_THRESHOLD=0.05
ML_RANDOM_SEED=42
ML_CONFIDENCE_THRESHOLD=0.70
ML_ANOMALY_SCORE_THRESHOLD=0.60
ML_DATASET_DIR=data/raw

# Threat Intelligence (Optional External APIs)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GEOIP_DATABASE_PATH=

# Alerting & Notifications (SMTP / Webhook)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=True
ALERT_FROM_EMAIL=alerts@ai-ids-ips.local
ALERT_NOTIFICATION_EMAIL=admin@example.com
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Seed Administrator Account (Created automatically on first migration/startup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@ai-ids-ips.local
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin123!
# Force the seeded administrator to change this password before any other route works.
INITIAL_ADMIN_FORCE_PASSWORD_CHANGE=True

# ==============================================================================
# Phase 2 Security Hardening
# ==============================================================================

# Argon2id password hashing (explicit, tunable; raise costs as hardware improves)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_DEPTH=5

# Account lockout and login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Server-side session policy
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Lax or Strict (Strict is recommended for an administrative console)
SESSION_COOKIE_SAMESITE=Strict

# Number of reverse proxies in front of the app for X-Forwarded-* trust.
# 0 disables forwarded-header trust entirely. Set to the exact hop count.
TRUSTED_PROXY_HOPS=0

# Flask-Limiter storage. Leave unset to use Redis in production and memory in
# development/testing. Set explicitly to override, e.g. redis://localhost:6379/1
RATELIMIT_STORAGE_URI=

# TOTP two-factor authentication
TOTP_ISSUER=AI-IDS-IPS-SOC
TOTP_VALID_WINDOW=1
RECOVERY_CODE_COUNT=10

# Comma-separated Socket.IO browser origins. Empty enforces same-origin only.
SOCKETIO_ALLOWED_ORIGINS=

